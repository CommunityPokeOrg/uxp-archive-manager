<?xml version="1.0" encoding="UTF-8"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:id>archive-manager@communitypoke.org</em:id>
    <em:version>1.0.0</em:version>
    <em:type>2</em:type>
    <em:bootstrap>true</em:bootstrap>
    <em:name>Archive Manager</em:name>
    <em:description>Inspect and extract ZIP, TAR/TAR.GZ/TAR.XZ, RAR and 7z archives with safe-extraction guards.</em:description>
    <em:creator>CommunityPoke</em:creator>
    <em:homepageURL>https://github.com/CommunityPokeOrg/uxp-archive-manager</em:homepageURL>
    <em:iconURL>chrome://archive-manager/skin/icon.png</em:iconURL>

    <!-- Pale Moon (UXP). Other UXP applications (Basilisk, Interlink, Borealis)
         can be enabled by adding their application ID below. -->
    <em:targetApplication>
      <Description>
        <em:id>{8de7fcbb-c55c-4fbe-bfc5-fc555c87dbc4}</em:id>
        <em:minVersion>27.0</em:minVersion>
        <em:maxVersion>*</em:maxVersion>
      </Description>
    </em:targetApplication>

    <em:targetApplication>
      <Description>
        <!-- Basilisk / UXP toolkit applications -->
        <em:id>{ec8030f7-c20a-464f-9b0e-13a3a9e97384}</em:id>
        <em:minVersion>52.0</em:minVersion>
        <em:maxVersion>*</em:maxVersion>
      </Description>
    </em:targetApplication>

    <em:targetApplication>
      <Description>
        <!-- UXP toolkit fallback -->
        <em:id>toolkit@mozilla.org</em:id>
        <em:minVersion>52.0</em:minVersion>
        <em:maxVersion>*</em:maxVersion>
      </Description>
    </em:targetApplication>
  </Description>
</RDF>
